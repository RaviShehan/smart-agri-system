generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CropZone {
  id                String      @id @default(uuid())
  name              String
  cropType          String
  deviceId          String      @unique
  moistureThreshold Int         @default(45)
  createdAt         DateTime    @default(now())
  telemetries       Telemetry[]
}

model Telemetry {
  id          String   @id @default(uuid())
  cropZoneId  String?
  moisture    Int
  temperature Int
  recordedAt  DateTime @default(now())

  cropZone    CropZone? @relation(fields: [cropZoneId], references: [id], onDelete: Cascade)
}
