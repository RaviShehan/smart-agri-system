generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CropZone {
  id               String      @id @default(uuid())
  name             String
  cropType         String
  moistureThreshold Float
  createdAt        DateTime    @default(now())
  telemetries      Telemetry[]
}

model Telemetry {
  id          String    @id @default(uuid())
  moisture    Float
  temperature Float
  recordedAt  DateTime  @default(now())
  cropZoneId  String?
  cropZone    CropZone? @relation(fields: [cropZoneId], references: [id])
}
