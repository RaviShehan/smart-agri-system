{
  "folders": [
    {
      "name": "Backend Core (Node.js)",
      "path": "services/backend-core"
    },
    {
      "name": "Telemetry Engine (Python)",
      "path": "services/telemetry-engine"
    },
    {
      "name": "Frontend (React)",
      "path": "services/frontend"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
